# Aiman Environment Variables
# Copy this file to .env and fill in your actual values. Never commit .env to git.

# LLM Provider (Anthropic / Qwen / DeepSeek — whichever you choose)
ANTHROPIC_API_KEY=your_key_here

# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_service_role_key

# WhatsApp Business API (Meta)
WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=choose_any_random_string_here
